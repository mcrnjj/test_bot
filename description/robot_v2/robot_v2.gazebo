<?xml version="1.0"?>
<!--
    Plugins y propiedades Gazebo para robot_v2 (Foxy / Gazebo Classic 11).
    Version ros2_control (claude_description): usa gazebo_ros2_control +
    diff_drive_controller (ver config/controllers.yaml) en lugar del plugin
    libgazebo_ros_diff_drive.

      - gazebo_ros2_control -> controller_manager dentro de Gazebo.
        Los controladores (joint_state_broadcaster, diff_drive_controller) se
        cargan desde launch_sim.launch.py con spawner.py.
      - camera -> /camera/image_raw, /camera/camera_info (frame optico).
      - imu    -> /imu/data.

    Topics del diff_drive_controller (por defecto, relativos al nombre del
    controlador):
        cmd_vel  IN : /diff_drive_controller/cmd_vel_unstamped (Twist)
        odom    OUT : /diff_drive_controller/odom
    enable_odom_tf (en controllers.yaml) controla la TF odom->base_link.

    NOTA geometria: wheel_separation/radius viven en controllers.yaml
    (derivados del export: sep ~0.169 m, ruedas 65 mm). Si gira al reves,
    intercambiar left_wheel_names/right_wheel_names en controllers.yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================= ros2_control (Gazebo) ===================== -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find test_bot)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ============================== CAMARA ============================== -->
  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.3439</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>1280</width>
          <height>720</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- =============================== IMU =============================== -->
  <gazebo reference="imu_link">
    <material>Gazebo/Orange</material>
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.112</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.073</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.008</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.011</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.013</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== MATERIALES / FRICCION ====================== -->
  <gazebo reference="body_link">
    <material>Gazebo/Silver</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <!-- Ruedas con traccion (mu alto) -->
  <gazebo reference="65mmWheel_v3_1">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="65mmWheel_v3__1__1">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- Caster / bola deslizante sin friccion -->
  <gazebo reference="sim_caster_v8_1">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="bola_v1_1">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="esfera_deslizante">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

</robot>
