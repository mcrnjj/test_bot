<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- Iluminacion y fisica estandar -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!--
      Recinto: 0.76 m (X) x 3.00 m (Y), paredes de 5 cm de grosor y 1 m de alto.
      Caras interiores en x=+/-0.38 y y=+/-1.50.
      Centros de pared desplazados 0.025 m (mitad del grosor) hacia afuera.
    -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 1.525 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.86 0.05 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.86 0.05 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.525 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.86 0.05 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.86 0.05 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-0.405 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 3.0 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.05 3.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>0.405 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 3.0 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.05 3.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

  
    <!-- ArUco fiducial markers (auto-generated) -->
    <include>
      <name>aruco_marker_0</name>
      <uri>model://aruco_marker_0</uri>
      <pose>-0.37 1.35 0.2 1.5707963267948963 0.0 1.5707963267948963</pose>
    </include>
    <include>
      <name>aruco_marker_1</name>
      <uri>model://aruco_marker_1</uri>
      <pose>0.37 -1.35 0.2 1.5707963267948963 0.0 -1.5707963267948963</pose>
    </include>
    <include>
      <name>aruco_marker_2</name>
      <uri>model://aruco_marker_2</uri>
      <pose>-0.37 -0.5 0.2 1.5707963267948963 0.0 1.5707963267948963</pose>
    </include>
  </world>
</sdf>
