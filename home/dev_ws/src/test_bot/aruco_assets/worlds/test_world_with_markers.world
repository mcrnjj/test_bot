<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- Iluminacion / suelo -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ====== Paredes externas ====== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 0.05 1.0</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>5.0 0.05 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.0 0.5 0 0 0</pose>
